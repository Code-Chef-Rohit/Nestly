{
  "expo": {
    "name": "Nestly",
    "slug": "nestly",
    "scheme": "nestly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D7A5F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nestly.app"
    },
    "android": {
      "package": "com.nestly.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0D7A5F"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nestly to access your photos to attach pictures of civic reports.",
          "cameraPermission": "Allow Nestly to access your camera to take pictures of civic issues."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Nestly to access your location to discover your local residential community."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1654d131-075d-47e1-a145-d24f20f3543c"
      }
    }
  }
}
